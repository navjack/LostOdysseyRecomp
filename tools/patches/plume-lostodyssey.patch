+// Cube texture fragment shader
+// Samples from a cubemap texture
+
+[[vk::binding(0, 0)]] TextureCube<float4> cubeTexture : register(t0);
+[[vk::binding(1, 0)]] SamplerState cubeSampler : register(s1);
